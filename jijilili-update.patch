+
+  /* ===================== 玩玩玩玩 › 到此一游 ===================== */
+  .pl-top{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;}
+  .pl-stats{display:flex;gap:22px;flex-wrap:wrap;}
+  .pl-stat{font-size:13.5px;color:var(--text-light);}
+  .pl-stat b{font-size:30px;font-weight:800;color:var(--accent-dark);margin:0 5px;vertical-align:-2px;}
+  .pl-actions{display:flex;gap:8px;flex-wrap:wrap;}
+  .pl-globe-card{padding:14px 10px 10px;background:linear-gradient(180deg,#FFF1F4 0%,#EAF6FD 100%);}
+  .pl-globe-wrap{width:100%;max-width:520px;aspect-ratio:1/1;margin:0 auto;}
+  .pl-globe{width:100%;height:100%;display:block;touch-action:pan-y;cursor:grab;user-select:none;-webkit-user-select:none;}
+  .pl-globe:active{cursor:grabbing;}
+  .pl-detail{padding:14px;}
+  .pl-photos{display:flex;gap:10px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:6px;margin-bottom:8px;}
+  .pl-photo{flex:0 0 min(100%,440px);aspect-ratio:4/3;border-radius:20px;overflow:hidden;border:none;padding:0;background:#F3ECE6;scroll-snap-align:start;cursor:zoom-in;}
+  .pl-photo img{width:100%;height:100%;object-fit:cover;display:block;}
+  .pl-d-head{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;}
+  .pl-d-head h3{margin:0;font-size:20px;}
+  .pl-date{font-size:12.5px;color:var(--text-light);}
+  .pl-quote{margin:10px 0 4px;padding:10px 14px;background:#FFF5E9;border-radius:14px;line-height:1.7;font-size:14.5px;}
+  .pl-d-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;}
+  .pl-members{display:flex;gap:6px;flex-wrap:wrap;margin-top:6px;}
+  .pl-chip{display:inline-flex;align-items:center;gap:5px;font-size:12px;background:#FFF1E4;border-radius:999px;padding:3px 10px 3px 7px;}
+  .pl-chip i,.pl-mchip i{width:9px;height:9px;border-radius:50%;display:inline-block;}
+  .pl-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:14px;}
+  .pl-card{background:var(--card);border-radius:22px;box-shadow:var(--shadow);overflow:hidden;cursor:pointer;transition:transform .15s;}
+  .pl-card:active{transform:scale(.985);}
+  .pl-cover{position:relative;aspect-ratio:4/3;background:#F3ECE6;}
+  .pl-cover img{width:100%;height:100%;object-fit:cover;display:block;}
+  .pl-nocover{display:flex;align-items:center;justify-content:center;font-size:40px;width:100%;height:100%;}
+  .pl-badge{position:absolute;right:10px;bottom:10px;background:rgba(0,0,0,.45);color:#fff;font-size:12px;border-radius:999px;padding:3px 9px;}
+  .pl-info{padding:12px 14px 14px;}
+  .pl-name{font-weight:800;font-size:16px;}
+  .pl-nopos{font-size:11px;font-weight:600;color:var(--text-light);background:#F3ECE6;border-radius:999px;padding:1px 7px;margin-left:4px;}
+  .pl-note-s{margin-top:6px;font-size:13.5px;line-height:1.6;color:var(--text);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
+  .pl-empty{text-align:center;padding:28px 16px 30px;}
+  .pl-empty-t{font-size:18px;font-weight:800;margin:6px 0 4px;}
+  .pl-geo-ok{color:var(--green-dark);font-size:12.5px;}
+  .pl-geo-no{color:var(--text-light);font-size:12.5px;}
+  .pl-geo-sub{display:block;color:var(--text-light);font-size:11.5px;margin-top:2px;}
+  #plGeoState{min-height:18px;margin-top:6px;}
+  #plGeoState a{color:var(--accent-dark);font-size:12.5px;font-weight:700;}
+  .pl-chips{display:flex;gap:8px;flex-wrap:wrap;}
+  .pl-mchip{display:inline-flex;align-items:center;gap:6px;border:1.5px solid var(--border);background:#fff;border-radius:999px;padding:6px 13px 6px 10px;font-size:13px;cursor:pointer;}
+  .pl-mchip.on{border-color:var(--accent);background:#FFE9EE;font-weight:700;}
+  .pl-pthumb{width:84px;height:84px;border-radius:14px;}
